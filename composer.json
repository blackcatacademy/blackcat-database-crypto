{
  "name": "blackcatacademy/blackcat-database-crypto",
  "description": "Transparent crypto adapter for BlackCat Database writes (field-level envelope encryption + HMAC).",
  "type": "library",
  "license": "proprietary",
  "non-feature-branches": [
    "dev"
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "blackcatacademy/blackcat-config": "dev-dev",
    "blackcat/crypto": "dev-dev as dev-main",
    "blackcatacademy/blackcat-database": "dev-dev || dev-main || dev-integration/dev || dev-release/main"
  },
  "autoload": {
    "psr-4": {
      "BlackCat\\DatabaseCrypto\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BlackCat\\DatabaseCrypto\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.11"
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/blackcatacademy/blackcat-core.git"
    },
    {
      "type": "git",
      "url": "https://github.com/blackcatacademy/blackcat-config.git"
    },
    {
      "type": "git",
      "url": "https://github.com/blackcatacademy/blackcat-database.git"
    },
    {
      "type": "git",
      "url": "https://github.com/blackcatacademy/blackcat-crypto.git"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
