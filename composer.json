{
  "name": "blackcatacademy/blackcat-database-crypto",
  "description": "Transparent crypto adapter for BlackCat Database writes (field-level envelope encryption + HMAC).",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "blackcat/crypto": "dev-dev as dev-main",
    "blackcatacademy/blackcat-database": "dev-dev"
  },
  "autoload": {
    "psr-4": {
      "BlackCat\\DatabaseCrypto\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BlackCat\\DatabaseCrypto\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/db-crypto-plan",
    "bin/db-crypto-schema",
    "bin/db-crypto-keys-sync",
    "bin/db-crypto-telemetry"
  ],
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.11"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/blackcatacademy/blackcat-core"
    },
    {
      "type": "vcs",
      "url": "https://github.com/blackcatacademy/blackcat-database"
    },
    {
      "type": "vcs",
      "url": "https://github.com/blackcatacademy/blackcat-crypto"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
