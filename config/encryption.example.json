{
  "tables": {
    "users": {
      "columns": {
        "email_hash": {
          "strategy": "hmac",
          "context": "core.hmac.email",
          "encoding": "raw",
          "write_key_version": true
        }
      }
    },
    "orders": {
      "columns": {
        "encrypted_customer_blob": {
          "strategy": "encrypt",
          "context": "core.vault",
          "write_key_version": true,
          "write_encryption_meta": true
        }
      }
    }
  }
}
